{
  "version": 2,
  "rewrites": [
    {
      "source": "/frame",
      "destination": "/api?__route=/frame"
    },
    {
      "source": "/frame/(.*)",
      "destination": "/api?__route=/frame/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/api?__route=/assets/$1"
    },
    {
      "source": "/_serverFn/(.*)",
      "destination": "/api?__route=/_serverFn/$1"
    },
    {
      "source": "/_serverFn",
      "destination": "/api?__route=/_serverFn"
    },
    {
      "source": "/favicon.svg",
      "destination": "/api?__route=/favicon.svg"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api?__route=/api/$1"
    },
    {
      "source": "/((?!app-assets/|assets/|frame|api/|_serverFn|favicon\\.svg).*)",
      "destination": "/index.html"
    }
  ]
}
